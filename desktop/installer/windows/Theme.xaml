<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- hivedesk installer theme: graphite surfaces, amber accents (the tokens of docs/1.0/DESIGN.md). -->
  <Color x:Key="CBg">#FF131519</Color>
  <Color x:Key="CAmber">#FFFFB531</Color>
  <SolidColorBrush x:Key="Bg" Color="#FF131519"/>
  <SolidColorBrush x:Key="Bg2" Color="#FF0E1013"/>
  <SolidColorBrush x:Key="Panel" Color="#FF181B20"/>
  <SolidColorBrush x:Key="Panel2" Color="#FF1F2329"/>
  <SolidColorBrush x:Key="Line" Color="#FF262A30"/>
  <SolidColorBrush x:Key="Line2" Color="#FF30353D"/>
  <SolidColorBrush x:Key="Text" Color="#FFE6E8EB"/>
  <SolidColorBrush x:Key="Text2" Color="#FFB4BAC3"/>
  <SolidColorBrush x:Key="Muted" Color="#FF8A919B"/>
  <SolidColorBrush x:Key="Amber" Color="#FFF2A93B"/>
  <SolidColorBrush x:Key="AmberSoft" Color="#FFF6C46F"/>
  <SolidColorBrush x:Key="AmberDim" Color="#26FFB531"/>
  <SolidColorBrush x:Key="Ink" Color="#FF17110A"/>
  <SolidColorBrush x:Key="Danger" Color="#FFE0695C"/>
  <LinearGradientBrush x:Key="AmberGrad" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFC85A" Offset="0"/>
    <GradientStop Color="#FFF2A11F" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AmberGradHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFD37A" Offset="0"/>
    <GradientStop Color="#FFF7AE33" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="MarkGrad" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FFFFD072" Offset="0"/>
    <GradientStop Color="#FFF09A1E" Offset="1"/>
  </LinearGradientBrush>
  <FontFamily x:Key="Ui">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Yu Gothic UI, Malgun Gothic</FontFamily>
  <FontFamily x:Key="UiDisplay">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI, Microsoft YaHei UI, Yu Gothic UI, Malgun Gothic</FontFamily>
  <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

  <!-- The Mel mark: a rounded hexagon with two bands. -->
  <Geometry x:Key="HexGeo">M 16,2.2 L 28,9.1 L 28,22.9 L 16,29.8 L 4,22.9 L 4,9.1 Z</Geometry>
  <DrawingImage x:Key="Mark">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <DrawingGroup.ClipGeometry><RectangleGeometry Rect="0,0,32,32"/></DrawingGroup.ClipGeometry>
        <GeometryDrawing Brush="{StaticResource MarkGrad}" Geometry="M 16,2.2 L 28,9.1 L 28,22.9 L 16,29.8 L 4,22.9 L 4,9.1 Z"/>
        <DrawingGroup>
          <DrawingGroup.ClipGeometry><PathGeometry Figures="M 16,2.2 L 28,9.1 L 28,22.9 L 16,29.8 L 4,22.9 L 4,9.1 Z"/></DrawingGroup.ClipGeometry>
          <GeometryDrawing Brush="#E61B1714" Geometry="M 0,12.2 H 32 V 15.2 H 0 Z"/>
          <GeometryDrawing Brush="#E61B1714" Geometry="M 0,18.6 H 32 V 21.6 H 0 Z"/>
          <GeometryDrawing Brush="#2EFFFFFF" Geometry="M 0,0 H 19 L 0,21 Z"/>
        </DrawingGroup>
        <GeometryDrawing Geometry="M 16,2.2 L 28,9.1 L 28,22.9 L 16,29.8 L 4,22.9 L 4,9.1 Z">
          <GeometryDrawing.Pen><Pen Brush="#73FFE3A3" Thickness="0.4"/></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Honeycomb texture for the art panel. -->
  <DrawingBrush x:Key="Comb" TileMode="Tile" Viewport="0,0,36,62.35" ViewportUnits="Absolute" Viewbox="0,0,72,124.7" ViewboxUnits="Absolute">
    <DrawingBrush.Drawing>
      <GeometryDrawing Geometry="M36 0 72 20.8v41.6L36 83.1 0 62.4V20.8zM0 62.4v41.6l36 20.7M72 62.4v41.6l-36 20.7">
        <GeometryDrawing.Pen><Pen Brush="#0FF2E9DA" Thickness="2"/></GeometryDrawing.Pen>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <Style x:Key="Base" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource Base}">
    <Setter Property="FontFamily" Value="{StaticResource UiDisplay}"/>
    <Setter Property="FontSize" Value="25"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>
  <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource Base}">
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Foreground" Value="{StaticResource Text2}"/>
    <Setter Property="LineHeight" Value="21"/>
  </Style>
  <Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource Base}">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
  </Style>

  <Style x:Key="BtnBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Padding" Value="18,0"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="MinWidth" Value="96"/>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" CornerRadius="10" Background="{StaticResource AmberGrad}" Padding="{TemplateBinding Padding}">
            <Border.Effect><DropShadowEffect Color="#FFF2A11F" BlurRadius="18" ShadowDepth="0" Opacity="0.28"/></Border.Effect>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource AmberGradHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AmberSoft}"/><Setter TargetName="b" Property="BorderThickness" Value="1.5"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" CornerRadius="10" Background="#0AF2E9DA" BorderBrush="{StaticResource Line2}" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#17F2E9DA"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#22F2E9DA"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Amber}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Foreground" Value="{StaticResource Text2}"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" CornerRadius="10" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#12F2E9DA"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Link" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{StaticResource Text2}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Foreground" Value="{StaticResource AmberSoft}"/><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="t" Property="Foreground" Value="{StaticResource AmberSoft}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Chrome" TargetType="Button">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Foreground" Value="{StaticResource Text2}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" CornerRadius="8" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#14F2E9DA"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
            <Trigger Property="Tag" Value="close"><Setter Property="Foreground" Value="{StaticResource Text2}"/></Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="Tag" Value="close"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions>
              <Setter TargetName="b" Property="Background" Value="#FFC94F43"/><Setter Property="Foreground" Value="White"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A switch for the options. -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="track" Width="36" Height="20" CornerRadius="10" Background="#FF2B2E34" BorderBrush="{StaticResource Line2}" BorderThickness="1" VerticalAlignment="Center">
              <Ellipse x:Name="knob" Width="14" Height="14" Fill="#FFB9BCC3" HorizontalAlignment="Left" Margin="2,0,0,0"/>
            </Border>
            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{StaticResource AmberGrad}"/>
              <Setter TargetName="track" Property="BorderBrush" Value="Transparent"/>
              <Setter TargetName="knob" Property="Fill" Value="#FF1A1206"/>
              <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="{StaticResource AmberSoft}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Field" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="CaretBrush" Value="{StaticResource Amber}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource Amber}"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="b" CornerRadius="10" Background="#FF0D0E10" BorderBrush="{StaticResource Line2}" BorderThickness="1" Padding="10,0">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Amber}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A slim scroll bar. -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8"/>
    <Setter Property="MinWidth" Value="8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb"><Border CornerRadius="4" Background="#40F2E9DA" Margin="1,2"/></ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
