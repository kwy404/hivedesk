{
  "name": "hivedesk",
  "version": "1.0.1",
  "description": "A crew of AI workers that plan, talk and build real files on your machine with a local model.",
  "type": "module",
  "bin": {
    "hivedesk": "src/cli.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./reduce": "./src/replay/reduce.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "ui",
    "!ui/screenshots",
    "desktop",
    "assets",
    "i18n",
    "themes",
    "extensions",
    "PROTOCOL.md",
    "FIRST-RUN.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "demo": "node src/cli.js --demo",
    "doctor": "node src/cli.js --doctor",
    "lint": "node scripts/lint.mjs",
    "rules": "node scripts/check-rules.mjs",
    "site": "node scripts/check-site.mjs",
    "test": "vitest run",
    "e2e:lend": "node test/lend/e2e-lend.mjs",
    "e2e:ui": "node test/e2e-ui.mjs",
    "e2e:local": "node test/e2e-local.mjs",
    "smoke:desktop": "node desktop/scripts/smoke.mjs",
    "e2e:phone": "node test/phone/e2e-phone.mjs",
    "e2e:two": "node test/e2e-two-engines.mjs",
    "e2e:projects": "node test/e2e-projects.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "agents",
    "local-model",
    "llm",
    "desktop",
    "code-generation"
  ],
  "author": "Alexandre Kohler (https://github.com/kwy404)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwy404/hivedesk.git"
  },
  "homepage": "https://kwy404.github.io/hivedesk/",
  "bugs": {
    "url": "https://github.com/kwy404/hivedesk/issues"
  },
  "devDependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "monaco-editor": "0.52.2",
    "playwright-core": "1.63.0",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  }
}
